# GEMINI_API_KEY: Required for Gemini AI API calls (server-side only, never expose to client).
# AI Studio automatically injects this at runtime from user secrets.
# On Vercel, set GEMINI_API_KEY in Project Settings > Environment Variables.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The canonical production URL where this app is hosted (e.g., https://khanabanana.vercel.app).
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# On Vercel, set APP_URL to your production domain for strict CORS and link resolution.
APP_URL="MY_APP_URL"

# ALLOWED_ORIGINS (Optional): Comma-separated extra origins allowed for CORS (e.g., https://custom-domain.com).
# ALLOWED_ORIGINS=""

# REQUIRE_FIREBASE_AUTH (Optional): Set to "true" in strict production to require a verified Firebase Bearer ID token on all AI API routes.
# REQUIRE_FIREBASE_AUTH="false"

